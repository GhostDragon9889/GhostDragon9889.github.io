<% const entries = site.posts.filter(post => post.collection === 'reading').sort('date', -1); const topics = []; entries.each(post => { const topic = post.paper && post.paper.topic || '其他'; if (!topics.includes(topic)) topics.push(topic); }); %>
<section class="reading-page" aria-labelledby="reading-title">
  <a class="breadcrumb text-link" href="<%- url_for() %>#reading">← 返回主页</a>
  <header class="reading-header"><p class="section-label">LITERATURE NOTES</p><h1 class="reading-title" id="reading-title">文献阅读</h1><p class="reading-description">研究问题、核心方法、实验结果与局限，以及与其他工作的联系。</p></header>
<% if (entries.length) { %>
  <div class="content-filter" data-content-filter>
    <div class="filter-controls" role="group" aria-label="按论文主题筛选"><button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">全部</button>
<% topics.forEach(function(topic) { %>
      <button class="filter-button" type="button" data-filter="reading:<%= topic %>" aria-pressed="false"><%= topic %></button>
<% }); %>
    </div>
    <p class="filter-status" aria-live="polite" aria-atomic="true"></p>
<%- partial('_partial/entry-list', {entries: entries, filterable: true}) %>
    <p class="filter-empty empty-state" hidden>该主题暂无已发布笔记。</p>
  </div>
<% } else { %>
  <p class="empty-state">阅读笔记整理中。</p>
<% } %>
</section>

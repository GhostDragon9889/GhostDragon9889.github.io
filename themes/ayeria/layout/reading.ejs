<% const entries = site_records(['reading']).sort('paper.id', 1); %>
<section class="reading-page" aria-labelledby="reading-title">
  <a class="breadcrumb text-link" href="<%- site_home() %>#reading">← <%= site_text('backHome') %></a>
  <header class="reading-header"><p class="section-label">LITERATURE NOTES</p><h1 class="reading-title" id="reading-title"><%= site_text('reading') %></h1><p class="reading-description"><%= site_text('readingPageIntro') %></p></header>
  <aside class="collection-overview"><h2><%= site_text('coverage').replace('{count}', entries.length).replace('{topics}', site.data.paperread.topics.length) %></h2><p><%= site_text('scope') %></p><p><a href="<%- site_path('notes/') %>"><%= site_text('notebookTitle') %> →</a></p><a href="<%- site_path('knowledge/paperread-roadmap/') %>"><%= site_text('roadmap') %> →</a><details><summary><%= site_text('sourceNotes') %></summary><p><%= site_text('sourceIntegrity') %></p><ul><li><a href="<%- url_for('downloads/paperread/source-index.md') %>"><%= site_text('readingIndex') %> (.md)</a></li><li><a href="<%- url_for('downloads/paperread/source-summaries.md') %>"><%= site_text('sourceNotes') %> (.md)</a></li><li><a href="<%- url_for('downloads/paperread/source-manifest.json') %>"><%= site_text('sourceManifest') %> (.json)</a></li><li><a href="<%- url_for('downloads/paperread/source-roadmap.md') %>"><%= site_text('roadmap') %> (.md)</a></li></ul></details></aside>
  <div class="content-filter" data-content-filter data-count-label="<%= site_text('recordCount') %>">
    <div class="filter-controls" role="group" aria-label="<%= site_text('filterReading') %>"><button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true"><%= site_text('all') %></button>
<% site.data.paperread.topics.forEach(function(topic) { %>
      <button class="filter-button" type="button" data-filter="reading:<%= topic.id %>" aria-pressed="false"><%= site_locale() === 'en' ? topic.label_en : topic.label %></button>
<% }); %>
    </div>
    <p class="filter-status" aria-live="polite" aria-atomic="true"></p>
<%- partial('_partial/entry-list', {entries: entries, filterable: true}) %>
    <p class="filter-empty empty-state" hidden><%= site_text('readingFilterEmpty') %></p>
  </div>
</section>

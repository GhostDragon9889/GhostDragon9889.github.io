<% const entries = site_locale() === 'en' ? site_records(['reading','theory','evaluation','research','engineering','reproduction']) : page.posts; %>
<section class="reading-page" aria-labelledby="archive-title">
  <a class="breadcrumb text-link" href="<%- site_home() %>#knowledge">← <%= site_text('backHome') %></a>
  <header class="reading-header"><p class="section-label">ARCHIVE</p><h1 class="reading-title" id="archive-title"><%= page.category || (page.tag ? site_text('tagPrefix') + page.tag : site_text('archive')) %></h1><p class="reading-description"><%= site_text('archiveIntro') %><% if (page.year) { %> · <%= page.year %><% if (page.month) { %>.<%= page.month %><% } %><% } %></p></header>
  <ul class="archive-list">
<% entries.each(function(post) { %>
    <li><a class="archive-item" href="<%- url_for(post.path) %>"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span class="archive-title"><%= post.title %></span><span class="archive-arrow" aria-hidden="true">→</span></a></li>
<% }); %>
  </ul>
<% if (!entries.length) { %><p class="archive-empty"><%= site_text('archiveEmpty') %></p><% } %>
<% if (page.total > 1) { %><nav class="archive-pagination" aria-label="<%= site_text('archive') %>"><%- paginator({prev_text: site_text('previous'), next_text: site_text('next')}) %></nav><% } %>
</section>

<article class="reading-page section-block" aria-labelledby="post-title">
  <a class="breadcrumb text-link" href="<%- url_for() %>#notes">← 返回主页</a>
  <header class="reading-header">
    <p class="section-label">NOTES / 文字记录</p>
    <h1 class="reading-title" id="post-title"><%= page.title %></h1>
    <time class="reading-date" datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time>
  </header>
  <div class="post-content"><%- page.content %></div>
  <footer class="reading-footer"><a class="text-link" href="<%- url_for('archives/') %>">查看全部记录 <span aria-hidden="true">↗</span></a></footer>
</article>

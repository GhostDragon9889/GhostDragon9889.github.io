<% const returnSection = page.collection === 'reading' ? 'reading' : page.collection === 'profile' ? 'education' : 'knowledge'; %>
<article class="reading-page" aria-labelledby="post-title">
  <a class="breadcrumb text-link" href="<%- site_home() %>#<%= returnSection %>">← <%= site_text('backHome') %></a>
  <header class="reading-header"><p class="section-label"><%= site_group(page.collection) %></p><h1 class="reading-title" id="post-title"><%= page.title %></h1><time class="reading-date" datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time></header>
<% if (page.paper && page.paper.title) { %>
  <aside class="paper-reference" aria-label="<%= site_text('paperInfo') %>"><h2><%= page.paper.title %></h2><p><%= site_text('paperId') %>: <%= page.paper.id %> · <%= site_topic(page.paper) %></p><p><%= site_text('paperVersion') %>: <%= page.paper.version %> · <%= page.paper.year %></p><p><%= site_text('sourceLabel') %>: <%= site_text(page.paper.supplement ? 'supplementLabel' : 'attachmentLabel') %></p><p><%= site_text('paperEvidence') %></p><% if (page.paper.url) { %><a class="text-link" href="<%= page.paper.url %>" target="_blank" rel="noopener noreferrer"><%= site_text('originalPaper') %> <%- partial('_partial/external-link-icon') %></a><% } %></aside>
<% } %>
  <div class="post-content"><%- page.content %></div>
  <footer class="reading-footer"><a class="text-link" href="<%- site_path(page.collection === 'reading' ? 'reading/' : 'knowledge/') %>"><%= site_text('backDirectory') %> →</a><a class="text-link" href="<%- site_path('archives/') %>"><%= site_text('allArticles') %> →</a></footer>
</article>

<% const navSection = site_is_home() || page.collection === 'profile' ? 'about' : page.tutorial || page.layout === 'tutorials' ? 'tutorials' : page.collection === 'reading' || page.layout === 'reading' ? 'reading' : page.layout === 'archive' || is_archive() ? 'archive' : page.collection || page.layout === 'knowledge' || page.layout === 'notebook' ? 'knowledge' : ''; %>
  <a class="skip-link" href="#main"><%= site_text('skip') %></a>
  <header class="site-header site-shell">
    <a class="brand" href="<%- site_home() %>" aria-label="<%= profile.name %> <%= site_text('homeAria') %>">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none"><path d="m11 10-6 6 6 6m10-12 6 6-6 6m-3-15-4 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="brand-name"><%= profile.name %><span class="brand-dot">.</span></span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="<%= site_text('navigation') %>">
      <ul>
        <li><a href="<%- site_home() %>#about" <% if (navSection === 'about') { %>class="is-active" aria-current="location"<% } %>><%= site_text('about') %></a></li>
        <li><a href="<%- site_home() %>#scholar"><%= site_text('scholar') %></a></li>
        <li><a href="<%- site_home() %>#reading" <% if (navSection === 'reading') { %>aria-current="location"<% } %>><%= site_text('reading') %></a></li>
        <li><a href="<%- site_path('tutorials/') %>" <% if (navSection === 'tutorials') { %>aria-current="location"<% } %>><%= site_text('tutorialNav') %></a></li>
        <li><a href="<%- site_home() %>#knowledge" <% if (navSection === 'knowledge') { %>aria-current="location"<% } %>><%= site_text('knowledge') %></a></li>
        <li><a href="<%- site_path('archives/') %>" <% if (navSection === 'archive') { %>aria-current="location"<% } %>><%= site_text('archiveNav') %></a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <a class="language-switch" data-language-switch href="<%- site_alternate() %>" lang="<%= site_locale() === 'en' ? 'zh-CN' : 'en' %>" hreflang="<%= site_locale() === 'en' ? 'zh-CN' : 'en' %>" aria-label="<%= site_text('languageLabel') %>"><%= site_text('languageName') %></a>
      <a class="github-link" href="<%= profile.github %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site_text('githubAria') %>">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.82.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.81c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
      </a>
      <button class="theme-toggle" data-dark-label="<%= site_text('themeDark') %>" data-light-label="<%= site_text('themeLight') %>" type="button" aria-label="<%= site_text('themeDark') %>" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" stroke-linecap="round"/></svg>
      </button>
      <button class="menu-toggle" data-open-label="<%= site_text('menuOpen') %>" data-close-label="<%= site_text('menuClose') %>" type="button" aria-label="<%= site_text('menuOpen') %>" aria-controls="site-nav" aria-expanded="false">
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

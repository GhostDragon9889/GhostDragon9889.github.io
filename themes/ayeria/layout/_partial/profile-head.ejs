<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="theme-color" content="#f7f8f5">
  <title><% if (!is_home() && page.title) { %><%= page.title %> · <% } else if (is_archive()) { %>文字记录 · <% } %><%= profile.name %> · <%= profile.alias %></title>
  <link rel="canonical" href="<%- full_url_for(is_home() ? '' : page.path || '') %>">
  <link rel="icon" href="<%- url_for('images/profile-mark.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%- url_for('css/profile.css') %>">
  <script>
    try {
      if (localStorage.getItem('profile-theme') === 'dark') {
        document.documentElement.dataset.theme = 'dark';
      }
    } catch (_) {}
  </script>
  <script src="<%- url_for('js/profile.js') %>" defer></script>
</head>

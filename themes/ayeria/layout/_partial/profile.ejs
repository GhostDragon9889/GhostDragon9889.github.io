<% const profile = site.data.profile; const reading = site_records(['reading']).sort('paper.id', 1); const knowledge = site_records(['theory', 'evaluation', 'research', 'engineering', 'reproduction']); const featuredReading = reading.filter(record => record.featured); const featuredKnowledge = knowledge.filter(record => record.featured); %>
<section id="about" class="academic-intro" aria-labelledby="profile-title">
  <div class="profile-bio">
    <p class="profile-kicker">PERSONAL ACADEMIC PROFILE</p>
    <h1 id="profile-title"><%= profile.name %></h1>
    <p class="profile-subtitle"><%= site_text('subtitle') %></p>
    <p class="profile-description"><%= (site_locale() === 'en' ? profile.description_en : profile.description) %></p>
    <div class="profile-links">
      <a href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer">Google Scholar <%- partial('external-link-icon') %></a>
      <a href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">GitHub <%- partial('external-link-icon') %></a>
      <a href="#education"><%= site_text('education') %> <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <aside class="profile-outline" aria-label="<%= site_text('outline') %>">
    <p class="outline-label"><%= site_text('outline') %></p>
    <p><%= site_text('outlineReading') %></p>
    <p><%= site_text('outlineResearch') %></p>
    <p><%= site_text('outlineEngineering') %></p>
  </aside>
</section>
<section id="education" class="section-block" aria-labelledby="education-title">
  <div class="section-heading-row"><h2 id="education-title"><%= site_text('education') %></h2><a class="text-link" href="<%- site_path('2026/05/29/hello-world/') %>"><%= site_text('educationDetails') %> →</a></div>
  <ol class="timeline">
<% profile.education.forEach(function(item) { %>
    <li class="timeline-item">
      <div class="timeline-period"><span><%= item.period %></span><span class="degree-label"><%= (site_locale() === 'en' ? item.degree_en : item.degree) %></span></div>
      <div class="timeline-body"><h3><%= (site_locale() === 'en' ? item.school_en : item.school) %></h3><p><%= (site_locale() === 'en' ? item.department_en : item.department) %></p><% if (item.note) { %><span class="timeline-note"><%= (site_locale() === 'en' ? item.note_en : item.note) %></span><% } %></div>
    </li>
<% }); %>
  </ol>
</section>
<section id="scholar" class="section-block" aria-labelledby="scholar-title">
  <div class="section-heading"><h2 id="scholar-title"><%= site_text('scholar') %></h2></div>
  <div class="scholar-panel">
    <div><h3>Google Scholar</h3><p><%= site_text('scholarDescription') %></p></div>
    <a class="text-link" href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer"><%= site_text('scholarVisit') %> <%- partial('external-link-icon') %></a>
  </div>
<% if (profile.publications && profile.publications.length) { %>
  <ol class="publication-list">
<% profile.publications.forEach(function(paper) { %>
    <li><h3><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer"><%= paper.title %></a></h3><p><%= paper.authors %></p><p class="publication-venue"><%= paper.venue %> · <%= paper.year %></p></li>
<% }); %>
  </ol>
<% } %>
</section>
<section id="reading" class="section-block" aria-labelledby="reading-title">
  <div class="section-heading-row"><h2 id="reading-title"><%= site_text('reading') %></h2><a class="text-link" href="<%- site_path('reading/') %>"><%= site_text('readingDirectory') %> →</a></div>
  <p class="section-intro"><%= site_text('readingIntro') %></p>
<% if (reading.length) { %>
<%- partial('entry-list', {entries: (featuredReading.length ? featuredReading : reading).limit(3), filterable: false}) %>
<% } else { %>
  <p class="empty-state"><%= site_text('readingEmpty') %></p>
<% } %>
</section>
<section id="tutorials" class="section-block" aria-labelledby="tutorials-title">
  <div class="section-heading-row"><h2 id="tutorials-title"><%= site_text('tutorialTitle') %></h2><a class="text-link" href="<%- site_path('tutorials/') %>"><%= site_text('tutorialDirectory') %> →</a></div>
  <p class="section-intro"><%= site_text('tutorialIntro').replace('{count}', site.data.tutorials.article_count) %></p>
<% const tutorialIds = site.data.tutorials.entries.filter(item => item.featured).map(item => item.id); const tutorialEntries = knowledge.filter(record => record.tutorial && tutorialIds.includes(record.tutorial.id)); %>
<%- partial('entry-list', {entries: tutorialEntries.limit(3), filterable: false}) %>
</section>
<section id="knowledge" class="section-block" aria-labelledby="knowledge-title">
  <div class="section-heading-row"><h2 id="knowledge-title"><%= site_text('knowledge') %></h2><a class="text-link" href="<%- site_path('knowledge/') %>"><%= site_text('knowledgeDirectory') %> →</a></div>
<%- partial('notebook-overview') %>
  <div class="topic-summary">
<% site.data.collections.groups.filter(group => group.id !== 'reading').forEach(function(group) { %>
    <div><h3><%= (site_locale() === 'en' ? group.label_en : group.label) %></h3><p><%= (site_locale() === 'en' ? group.description_en : group.description) %></p></div>
<% }); %>
  </div>
<%- partial('entry-list', {entries: (featuredKnowledge.length ? featuredKnowledge : knowledge).limit(4), filterable: false}) %>
</section>

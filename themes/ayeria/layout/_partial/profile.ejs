<% const profile = site.data.profile; %>
    <section id="about" class="hero-grid" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> 欢迎来到我的小小世界</p>
        <h1 id="hero-title">你好，我是 <span class="hero-name"><%= profile.name %></span>。</h1>
        <p class="hero-tagline">保持好奇，<br><span class="accent">让想法生长。</span></p>
        <p class="hero-description"><%= profile.description %></p>
        <div class="hero-actions">
          <a class="button button-primary" href="#education">了解我的经历 <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">去 GitHub 看看 <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-footnote"><span aria-hidden="true">✳</span> <%= profile.alias %> / 个人主页</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-panel">
          <div class="art-topline"><span>THE SPACE OF IDEAS</span><span>↗</span></div>
          <svg class="orbit-art" viewBox="0 0 420 380" fill="none">
            <defs>
              <radialGradient id="orbit-glow"><stop stop-color="#c0ffb1" stop-opacity=".24"/><stop offset="1" stop-color="#c0ffb1" stop-opacity="0"/></radialGradient>
              <linearGradient id="orbit-line" x1="70" y1="70" x2="350" y2="320" gradientUnits="userSpaceOnUse"><stop stop-color="#e2f5b5"/><stop offset=".55" stop-color="#96cfab"/><stop offset="1" stop-color="#508c78"/></linearGradient>
              <pattern id="orbit-grid" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#c4dbc6" opacity=".16"/></pattern>
            </defs>
            <rect width="420" height="380" fill="url(#orbit-grid)"/>
            <circle cx="210" cy="190" r="170" fill="url(#orbit-glow)"/>
            <circle cx="210" cy="190" r="144" stroke="#aad3b6" stroke-opacity=".12" stroke-dasharray="3 8"/>
            <path d="M210 23v334M44 190h332" stroke="#aad3b6" stroke-opacity=".16"/>
            <g stroke="url(#orbit-line)" stroke-width="1.5">
              <ellipse cx="210" cy="190" rx="145" ry="65" transform="rotate(-35 210 190)"/>
              <ellipse cx="210" cy="190" rx="145" ry="65" transform="rotate(35 210 190)"/>
              <ellipse cx="210" cy="190" rx="145" ry="65" transform="rotate(90 210 190)"/>
            </g>
            <circle cx="210" cy="190" r="28" fill="#d5edbb" fill-opacity=".07" stroke="#bfdca2" stroke-opacity=".35"/>
            <path d="M210 166v48m-24-24h48m-41-17 34 34m-34 0 34-34" stroke="#dcf3b6" stroke-width="2" stroke-linecap="round"/>
            <circle cx="93" cy="108" r="6" fill="#e0f3b5"/>
            <circle cx="326" cy="273" r="4" fill="#86bba0"/>
            <circle cx="210" cy="45" r="5" fill="#bddb9d"/>
            <path d="M35 39h12m-6-6v12m333 290h12m-6-6v12" stroke="#a7c6a9" stroke-linecap="round"/>
            <text x="50" y="310" fill="#c8dfc5" font-size="10" font-family="monospace" letter-spacing="2">STAY CURIOUS</text>
          </svg>
          <div class="art-bottomline"><span>一点好奇，无限可能。</span><span>01 / ∞</span></div>
        </div>
        <p class="art-caption">LEARNING · THINKING · GROWING</p>
      </div>
    </section>
    <div class="section-divider" aria-hidden="true"></div>
    <section id="education" class="section-block" aria-labelledby="education-title">
      <div class="section-heading">
        <p class="section-label">01 / EDUCATION</p>
        <h2 id="education-title">学习的足迹<span class="accent">。</span></h2>
        <p class="section-intro">每一段经历，都是探索的一部分。</p>
      </div>
      <ol class="timeline">
<% profile.education.forEach(function(item) { %>
        <li class="timeline-item">
          <div class="timeline-period"><span><%= item.period %></span><span class="degree-label"><%= item.degree %></span></div>
          <div class="timeline-body">
            <h3><%= item.school %></h3>
            <p><%= item.department %></p>
<% if (item.note) { %><span class="timeline-note"><%= item.note %></span><% } %>
          </div>
        </li>
<% }); %>
      </ol>
    </section>
    <section id="notes" class="section-block" aria-labelledby="notes-title">
      <div class="section-heading">
        <p class="section-label">02 / NOTES</p>
        <div class="section-heading-row"><h2 id="notes-title">写下，留住<span class="accent">。</span></h2><a class="text-link" href="<%- url_for('archives/') %>">全部记录 <span aria-hidden="true">↗</span></a></div>
        <p class="section-intro">把走过的路、想过的事，慢慢记录下来。</p>
      </div>
      <div class="notes-grid">
<% site.posts.sort('date', -1).limit(3).each(function(post, index) { %>
        <a class="note-card" href="<%- url_for(post.path) %>">
          <div class="note-meta"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span class="note-index">0<%= index + 1 %></span></div>
          <h3><%= post.title || '学习经历' %></h3>
          <p class="note-excerpt"><%= post.description || truncate(strip_html(post.excerpt || post.content), {length: 80}) %></p>
          <span class="note-link">阅读记录 <span aria-hidden="true">↗</span></span>
        </a>
<% }); %>
      </div>
    </section>
    <section class="contact-section" aria-labelledby="contact-title">
      <div class="contact-copy"><p class="section-label">LET’S CONNECT</p><h2 id="contact-title">很高兴在这里遇见你。</h2><p>更多代码与探索，留在 GitHub。</p></div>
      <a class="button button-primary" href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">访问我的 GitHub <span aria-hidden="true">↗</span></a>
    </section>

<% const profile = site.data.profile; const reading = site.posts.filter(post => post.collection === 'reading').sort('date', -1); const knowledge = site.posts.filter(post => ['research', 'engineering', 'reproduction'].includes(post.collection)).sort('date', -1); %>
<section id="about" class="academic-intro" aria-labelledby="profile-title">
  <div class="profile-bio">
    <p class="profile-kicker">PERSONAL ACADEMIC PROFILE</p>
    <h1 id="profile-title"><%= profile.name %></h1>
    <p class="profile-subtitle">学术与工程记录</p>
    <p class="profile-description"><%= profile.description %></p>
    <div class="profile-links">
      <a href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
      <a href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href="#education">学习经历 <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <aside class="profile-outline" aria-label="内容方向">
    <p class="outline-label">内容方向</p>
    <p>文献阅读与方法分析</p>
    <p>学术讨论与研究记录</p>
    <p>工程实现与实验复现</p>
  </aside>
</section>
<section id="education" class="section-block" aria-labelledby="education-title">
  <div class="section-heading-row"><h2 id="education-title">学习经历</h2><a class="text-link" href="<%- url_for('2026/05/29/hello-world/') %>">详细记录 →</a></div>
  <ol class="timeline">
<% profile.education.forEach(function(item) { %>
    <li class="timeline-item">
      <div class="timeline-period"><span><%= item.period %></span><span class="degree-label"><%= item.degree %></span></div>
      <div class="timeline-body"><h3><%= item.school %></h3><p><%= item.department %></p><% if (item.note) { %><span class="timeline-note"><%= item.note %></span><% } %></div>
    </li>
<% }); %>
  </ol>
</section>
<section id="scholar" class="section-block" aria-labelledby="scholar-title">
  <div class="section-heading"><h2 id="scholar-title">学术信息</h2></div>
  <div class="scholar-panel">
    <div><h3>Google Scholar</h3><p>论文列表、引用信息与学术档案。</p></div>
    <a class="text-link" href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer">访问学术档案 ↗</a>
  </div>
<% if (profile.publications && profile.publications.length) { %>
  <ol class="publication-list">
<% profile.publications.forEach(function(paper) { %>
    <li><h3><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer"><%= paper.title %></a></h3><p><%= paper.authors %></p><p class="publication-venue"><%= paper.venue %> · <%= paper.year %></p></li>
<% }); %>
  </ol>
<% } %>
</section>
<section id="reading" class="section-block" aria-labelledby="reading-title">
  <div class="section-heading-row"><h2 id="reading-title">文献阅读</h2><a class="text-link" href="<%- url_for('reading/') %>">阅读目录 →</a></div>
  <p class="section-intro">围绕研究问题、核心方法、实验结果与局限整理阅读笔记。</p>
<% if (reading.length) { %>
<%- partial('entry-list', {entries: reading.limit(3), filterable: false}) %>
<% } else { %>
  <p class="empty-state">阅读笔记整理中。</p>
<% } %>
</section>
<section id="knowledge" class="section-block" aria-labelledby="knowledge-title">
  <div class="section-heading-row"><h2 id="knowledge-title">学术与工程</h2><a class="text-link" href="<%- url_for('knowledge/') %>">分类目录 →</a></div>
  <div class="topic-summary">
<% site.data.collections.groups.filter(group => group.id !== 'reading').forEach(function(group) { %>
    <div><h3><%= group.label %></h3><p><%= group.description %></p></div>
<% }); %>
  </div>
<%- partial('entry-list', {entries: knowledge.limit(4), filterable: false}) %>
</section>

<% const profile = site.data.profile; const english = site_locale() === 'en'; %>
<article class="reading-page" aria-labelledby="about-title">
  <a class="breadcrumb text-link" href="<%- site_home() %>">← <%= site_text('backHome') %></a>
  <header class="reading-header">
    <p class="section-label"><%= profile.name %></p>
    <h1 class="reading-title" id="about-title"><%= site_text('about') %></h1>
    <p class="reading-description"><%= english ? profile.description_en : profile.description %></p>
    <div class="profile-links">
      <a href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">GitHub <%- partial('_partial/external-link-icon') %></a>
      <a href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer">Google Scholar <%- partial('_partial/external-link-icon') %></a>
    </div>
  </header>
  <section id="education" class="section-block" aria-labelledby="education-title">
    <div class="section-heading"><h2 id="education-title"><%= site_text('education') %></h2></div>
    <ol class="timeline">
<% profile.education.forEach(function(item) { %>
      <li class="timeline-item">
        <div class="timeline-period"><span><%= item.period %></span><span class="degree-label"><%= english ? item.degree_en : item.degree %></span></div>
        <div class="timeline-body"><h3><%= english ? item.school_en : item.school %></h3><p><%= english ? item.department_en : item.department %></p><% if (item.note) { %><span class="timeline-note"><%= english ? item.note_en : item.note %></span><% } %></div>
      </li>
<% }); %>
    </ol>
  </section>
  <section id="scholar" class="section-block" aria-labelledby="scholar-title">
    <div class="section-heading"><h2 id="scholar-title"><%= site_text('scholar') %></h2></div>
    <div class="scholar-panel">
      <div><h3>Google Scholar</h3><p><%= site_text('scholarDescription') %></p></div>
      <a class="text-link" href="<%= profile.scholar %>" target="_blank" rel="noopener noreferrer"><%= site_text('scholarVisit') %> <%- partial('_partial/external-link-icon') %></a>
    </div>
<% if (profile.publications && profile.publications.length) { %>
    <ol class="publication-list">
<% profile.publications.forEach(function(paper) { %>
      <li><h3><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer"><%= paper.title %></a></h3><p><%= paper.authors %></p><p class="publication-venue"><%= paper.venue %> · <%= paper.year %></p></li>
<% }); %>
    </ol>
<% } %>
  </section>
</article>
